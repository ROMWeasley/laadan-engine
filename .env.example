# laadan-engine configuration template
# Copy to .env for local use. Never commit .env or real API keys.

# Network: loopback only by default
LAADAN_HOST=127.0.0.1
LAADAN_PORT=8000
# Accepted Host header values (protects against DNS rebinding)
LAADAN_ALLOWED_HOSTS=127.0.0.1,localhost

# Model mode: mock | direct | batched
# - mock:    local fixtures, no network access, no API key (default)
# - direct:  one model call per generation or intent action
# - batched: intent actions on the same route within the batch window share one call
LAADAN_MODEL_MODE=mock

# Model provider (only used in direct and batched mode; OpenAI-compatible API)
LAADAN_MODEL_BASE_URL=
LAADAN_MODEL_NAME=
LAADAN_MODEL_API_KEY=
LAADAN_MODEL_TIMEOUT_SECONDS=30

# Rate limiting (direct and batched mode)
LAADAN_MODEL_RPM=10
LAADAN_MODEL_MAX_WAIT_SECONDS=20
LAADAN_BATCH_WINDOW_MS=400

# Storage (SQLite file for entities and pages)
LAADAN_DATA_DIR=./data

# Logging
LAADAN_LOG_LEVEL=INFO
# Write full prompts and model responses to the local log (may contain your input)
LAADAN_LOG_PROMPTS=false
