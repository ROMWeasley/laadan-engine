# Laadan Engine Configuration Template
# Copy to .env for local configuration. Never commit actual secrets to version control.

# Server Network Configuration (Restricted to loopback by default)
LAADAN_HOST=127.0.0.1
LAADAN_PORT=8000
LAADAN_DEBUG=false

# Runtime Execution Mode: mock | direct | batched
# - mock: Deterministic local fixtures, zero external network, zero API cost (Default)
# - direct: Synchronous model gateway calls with backoff
# - batched: Action coalescing buffer with rate-limit governor
LAADAN_EXECUTION_MODE=mock

# Model Gateway Configuration (Optional - only required if LAADAN_EXECUTION_MODE != mock)
# LAADAN_MODEL_PROVIDER=openai_compatible
# LAADAN_MODEL_NAME=gpt-4o-mini
# LAADAN_MODEL_API_KEY=placeholder-api-key-do-not-commit
# LAADAN_MODEL_BASE_URL=https://api.example.com/v1

# Security & Governance
LAADAN_SESSION_SECRET=placeholder-development-secret-change-in-production
LAADAN_ENFORCE_STRICT_CSP=true
LAADAN_MAX_PAYLOAD_BYTES=65536
LAADAN_ACTION_COALESCE_DEBOUNCE_MS=250

# Logging & Diagnostics
LAADAN_LOG_LEVEL=INFO
LAADAN_LOG_PROVENANCE=true
